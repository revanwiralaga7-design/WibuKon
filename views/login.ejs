<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('layout/head') %>
</head>
<body class="pb-24 pt-16 md:pt-20 animate-fade">
    <%- include('layout/navbar') %>

    <main class="container mx-auto px-4 py-10 max-w-md">
        <div class="glass-card rounded-3xl p-6 md:p-8">
            <h1 class="text-2xl font-black text-white mb-1">Masuk</h1>
            <p class="text-sm text-zinc-500 mb-6">EXP kamu tersimpan di server & tersinkron di semua perangkat.</p>

            <% if (error) { %>
                <div class="mb-4 text-xs md:text-sm text-red-300 bg-red-500/10 border border-red-500/30 rounded-xl px-4 py-3"><%= error %></div>
            <% } %>

            <form method="POST" action="/login" class="space-y-4">
                <input type="hidden" name="next" value="<%= next %>">
                <div>
                    <label class="text-xs font-bold text-zinc-500 uppercase tracking-wider">Username</label>
                    <input name="username" required autocomplete="username" class="mt-1 w-full bg-zinc-800/80 border border-white/10 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:ring-2 focus:ring-purple-500">
                </div>
                <div>
                    <label class="text-xs font-bold text-zinc-500 uppercase tracking-wider">Password</label>
                    <input name="password" type="password" required autocomplete="current-password" class="mt-1 w-full bg-zinc-800/80 border border-white/10 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:ring-2 focus:ring-purple-500">
                </div>
                <button class="w-full bg-gradient-to-r from-purple-600 to-indigo-600 p-3.5 rounded-xl font-bold text-white text-sm active:scale-95 transition">Masuk</button>
            </form>

            <% if (google) { %>
            <div class="flex items-center gap-3 my-5">
                <div class="flex-1 h-px bg-white/10"></div>
                <span class="text-[10px] text-zinc-600 font-bold uppercase">atau</span>
                <div class="flex-1 h-px bg-white/10"></div>
            </div>
            <a href="/auth/google?next=<%= encodeURIComponent(next) %>" class="w-full flex items-center justify-center gap-3 bg-white hover:bg-zinc-100 rounded-xl p-3.5 transition active:scale-95">
                <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
                <span class="text-sm font-bold text-zinc-700">Masuk dengan Google</span>
            </a>
            <% } %>

            <p class="text-center text-xs text-zinc-500 mt-6">Belum punya akun? <a href="/register" class="text-purple-400 font-bold hover:text-purple-300">Daftar gratis</a></p>
        </div>
    </main>
</body>
</html>

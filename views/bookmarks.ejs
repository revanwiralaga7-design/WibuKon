<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('layout/head') %>
</head>
<body class="pb-24 pt-16 md:pt-20 animate-fade">
    <%- include('layout/navbar') %>

    <main class="container mx-auto px-4 py-6 min-h-[60vh]">
        <header class="mb-6 flex justify-between items-center">
            <h1 class="text-xl md:text-2xl font-bold text-white flex items-center gap-2">
                <svg class="w-6 h-6 text-purple-500" fill="currentColor" viewBox="0 0 24 24"><path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                Anime Tersimpan <span id="bookmarkCount" class="text-sm font-medium text-zinc-500"></span>
            </h1>
            <button id="clearBookmarksBtn" class="hidden text-xs text-red-400 hover:text-red-300 font-medium">Hapus Semua</button>
        </header>

        <section id="bookmarkGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3 sm:gap-4"></section>

        <section id="bookmarkEmpty" class="hidden flex-col items-center justify-center py-20 text-center animate-slide">
            <div class="w-24 h-24 bg-zinc-800/50 rounded-full flex items-center justify-center mb-6 border border-white/5">
                <svg class="w-10 h-10 text-zinc-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
            </div>
            <h2 class="text-xl md:text-2xl font-bold text-white mb-2">Belum Ada Bookmark</h2>
            <p class="text-zinc-500 max-w-sm mx-auto mb-8 text-sm md:text-base">
                Simpan anime favoritmu lewat tombol <span class="text-purple-400 font-bold">Simpan</span> di halaman detail anime.
            </p>
            <a href="/" class="bg-zinc-800 text-white px-6 py-2.5 rounded-full text-sm font-medium hover:bg-zinc-700 transition border border-white/5">
                Jelajahi Anime
            </a>
        </section>
    </main>

    <script>
        (function () {
            if (!window.WibuStore) return
            var esc = WibuStore.esc
            var grid = document.getElementById('bookmarkGrid')
            var empty = document.getElementById('bookmarkEmpty')
            var clearBtn = document.getElementById('clearBookmarksBtn')
            var count = document.getElementById('bookmarkCount')

            function render() {
                var items = WibuStore.getBookmarks()
                if (!items.length) {
                    grid.innerHTML = ''
                    empty.classList.remove('hidden')
                    empty.classList.add('flex')
                    clearBtn.classList.add('hidden')
                    count.textContent = ''
                    return
                }
                empty.classList.add('hidden')
                empty.classList.remove('flex')
                clearBtn.classList.remove('hidden')
                count.textContent = '(' + items.length + ')'
                grid.innerHTML = items.map(function (it) {
                    return '<article class="group relative rounded-xl overflow-hidden aspect-[3/4] glass-card hover:border-purple-500/50 transition duration-300">' +
                        '<img src="' + esc(it.img) + '" alt="' + esc(it.title) + '" loading="lazy" class="w-full h-full object-cover group-hover:scale-110 transition duration-500">' +
                        '<div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-80"></div>' +
                        '<div class="absolute bottom-0 p-2 sm:p-3 w-full">' +
                            '<h3 class="text-white text-[10px] sm:text-xs font-bold line-clamp-2 leading-tight group-hover:text-purple-300 transition">' + esc(it.title) + '</h3>' +
                            '<span class="text-[9px] sm:text-[10px] text-zinc-400 mt-1 block">' + esc(it.status || '') + (it.rating && it.rating !== '-' ? ' &bull; &starf; ' + esc(it.rating) : '') + '</span>' +
                        '</div>' +
                        '<a href="/anime/' + encodeURIComponent(it.slug) + '" aria-label="' + esc(it.title) + '" class="absolute inset-0 z-10"></a>' +
                        '<button data-id="' + esc(it.animeId) + '" class="js-rm-bookmark absolute top-2 right-2 z-20 p-1.5 rounded-full bg-black/70 text-zinc-400 hover:text-red-400 transition" aria-label="Hapus bookmark">' +
                            '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>' +
                        '</button>' +
                    '</article>'
                }).join('')
            }

            grid.addEventListener('click', function (e) {
                var btn = e.target.closest('.js-rm-bookmark')
                if (!btn) return
                e.preventDefault()
                WibuStore.removeBookmark(btn.dataset.id)
                render()
            })

            clearBtn.addEventListener('click', function () {
                WibuStore.clearBookmarks()
                render()
            })

            render()
        })()
    </script>
</body>
</html>

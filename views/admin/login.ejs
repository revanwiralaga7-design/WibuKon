<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('_head', { title: 'Login' }) %>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
    <div class="card rounded-3xl p-8 w-full max-w-sm">
        <h1 class="text-2xl font-black italic text-transparent bg-clip-text bg-gradient-to-r from-purple-500 to-indigo-500 text-center">WibuKon Admin</h1>
        <p class="text-center text-xs text-zinc-500 mt-1 mb-6">Panel kontrol — khusus admin & owner</p>

        <% if (error) { %>
            <div class="flash-err"><%= error %></div>
        <% } %>

        <form method="POST" action="/admin/login" class="space-y-4">
            <div>
                <label class="lbl">Username</label>
                <input name="username" class="input" required autocomplete="username">
            </div>
            <div>
                <label class="lbl">Password</label>
                <input name="password" type="password" class="input" required autocomplete="current-password">
            </div>
            <button class="btn w-full">Masuk Panel</button>
        </form>
        <p class="text-center mt-6"><a href="/" class="text-xs text-zinc-500 hover:text-white">← Kembali ke situs</a></p>
    </div>
</body>
</html>

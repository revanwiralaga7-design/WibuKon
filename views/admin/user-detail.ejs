<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('_head', { title: user.username }) %>
</head>
<body>
    <%- include('_nav', { admin, section }) %>

    <main class="max-w-5xl mx-auto p-4 md:p-8 space-y-6">
        <a href="/admin/users" class="text-xs text-zinc-500 hover:text-white">← Semua user</a>

        <% if (flash && flash.ok) { %><div class="flash-ok"><%= flash.ok %></div><% } %>
        <% if (flash && flash.err) { %><div class="flash-err"><%= flash.err %></div><% } %>

        <section class="card rounded-3xl p-6 flex flex-wrap items-center gap-6">
            <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-3xl" style="background:<%= st.rank.color %>22"><%= st.rank.icon %></div>
            <div class="flex-1 min-w-[200px]">
                <h1 class="text-2xl font-black text-white flex items-center gap-3 flex-wrap">
                    <%= user.username %>
                    <span class="text-[10px] font-black px-2 py-0.5 rounded-full <%= user.role === 'owner' ? 'bg-yellow-500/15 text-yellow-300 border border-yellow-500/30' : (user.role === 'admin' ? 'bg-purple-500/15 text-purple-300 border border-purple-500/30' : 'bg-zinc-500/15 text-zinc-400 border border-zinc-500/30') %>"><%= (user.role || 'user').toUpperCase() %></span>
                    <% if (user.is_banned) { %><span class="text-[10px] font-black px-2 py-0.5 rounded-full bg-red-500/15 text-red-400 border border-red-500/30">BANNED</span><% } %>
                </h1>
                <p class="text-sm text-zinc-400 mt-1">
                    Level <b class="text-white"><%= st.level.toLocaleString('id-ID') %></b>
                    <span style="color:<%= st.rank.color %>">(<%= st.rank.name %>)</span> ·
                    Total <b class="text-purple-400"><%= st.xp.toLocaleString('id-ID') %> EXP</b>
                </p>
                <p class="text-xs text-zinc-600 mt-1">Daftar: <%= new Date(user.created_at).toLocaleString('id-ID') %> · Terakhir aktif: <%= user.last_seen_at ? new Date(user.last_seen_at).toLocaleString('id-ID') : 'belum pernah' %></p>
            </div>
        </section>

        <div class="grid md:grid-cols-2 gap-6">
            <section class="card rounded-2xl p-5 space-y-4">
                <h2 class="font-bold text-white">Sesuaikan EXP</h2>
                <form method="POST" action="/admin/users/<%= user.id %>/exp" class="space-y-3">
                    <div>
                        <label class="lbl">Jumlah (+ tambah / − kurang)</label>
                        <input name="delta" type="number" class="input" placeholder="contoh: 500 atau -250" required>
                    </div>
                    <div>
                        <label class="lbl">Alasan</label>
                        <input name="reason" class="input" placeholder="contoh: Hadiah event / Penalti farming" maxlength="80">
                    </div>
                    <button class="btn w-full">Terapkan</button>
                </form>

                <form method="POST" action="/admin/users/<%= user.id %>/ban" onsubmit="return confirm('Yakin?')">
                    <button class="btn <%= user.is_banned ? 'btn-gray' : 'btn-red' %> w-full">
                        <%= user.is_banned ? 'Buka Blokir User' : 'Blokir User (ban + keluarkan sesi)' %>
                    </button>
                </form>

                <div class="border-t border-white/5 pt-4">
                    <h2 class="font-bold text-white mb-1">💎 Status VIP</h2>
                    <p class="text-[11px] text-zinc-500 mb-3">
                        <% if (user.vip) { %>Sekarang: <b class="text-amber-300">VIP PERMANEN</b><% } else if (user.vip_until && new Date(user.vip_until).getTime() > Date.now()) { %>Sekarang: <b class="text-cyan-300">VIP sampai <%= new Date(user.vip_until).toLocaleString('id-ID') %></b><% } else { %>Sekarang: <b class="text-zinc-400">bukan VIP</b><% } %>
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <form method="POST" action="/admin/users/<%= user.id %>/vip"><input type="hidden" name="kind" value="days30"><button class="btn btn-gray text-xs px-3 py-2">+ VIP 30 hari</button></form>
                        <form method="POST" action="/admin/users/<%= user.id %>/vip"><input type="hidden" name="kind" value="permanent"><button class="btn text-xs px-3 py-2">VIP Permanen</button></form>
                        <form method="POST" action="/admin/users/<%= user.id %>/vip" onsubmit="return confirm('Cabut VIP user ini?')"><input type="hidden" name="kind" value="revoke"><button class="btn btn-red text-xs px-3 py-2">Cabut VIP</button></form>
                    </div>
                </div>

                <% if (admin.role === 'owner') { %>
                <div class="border-t border-white/5 pt-4">
                    <h2 class="font-bold text-white mb-1">Role Publik (command komentar & badge)</h2>
                    <p class="text-[11px] text-zinc-500 mb-3">admin/owner: badge di komentar & leaderboard, bisa menghapus komentar siapa pun.</p>
                    <form method="POST" action="/admin/users/<%= user.id %>/role" class="flex gap-2">
                        <select name="role" class="input">
                            <option value="user" <%= (user.role || 'user') === 'user' ? 'selected' : '' %>>user — biasa</option>
                            <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>admin — staff</option>
                            <option value="owner" <%= user.role === 'owner' ? 'selected' : '' %>>owner — staff penuh</option>
                        </select>
                        <button class="btn shrink-0">Ubah Role</button>
                    </form>
                </div>
                <% } %>
            </section>

            <section class="card rounded-2xl p-5">
                <h2 class="font-bold text-white mb-4">Riwayat EXP (30 terakhir)</h2>
                <div class="divide-y divide-white/5 max-h-96 overflow-y-auto">
                    <% events.forEach(e => { %>
                        <div class="flex justify-between items-center py-2">
                            <div class="min-w-0 pr-3">
                                <div class="text-xs text-zinc-300 truncate"><%= e.label || e.event_key %></div>
                                <div class="text-[10px] text-zinc-600"><%= new Date(e.created_at).toLocaleString('id-ID') %></div>
                            </div>
                            <span class="text-xs font-bold shrink-0 <%= e.amount >= 0 ? 'text-purple-400' : 'text-red-400' %>"><%= e.amount >= 0 ? '+' : '' %><%= e.amount %> EXP</span>
                        </div>
                    <% }) %>
                    <% if (!events.length) { %><p class="text-sm text-zinc-500 py-4 text-center">Belum ada riwayat.</p><% } %>
                </div>
            </section>
        </div>
    </main>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('_head', { title: 'Kelola Admin' }) %>
</head>
<body>
    <%- include('_nav', { admin, section }) %>

    <main class="max-w-4xl mx-auto p-4 md:p-8 space-y-6">
        <h1 class="text-xl md:text-2xl font-black text-white">Kelola Akun Admin</h1>

        <% if (flash && flash.ok) { %><div class="flash-ok"><%= flash.ok %></div><% } %>
        <% if (flash && flash.err) { %><div class="flash-err"><%= flash.err %></div><% } %>

        <section class="card rounded-2xl overflow-x-auto">
            <table class="tb w-full">
                <thead><tr><th>ID</th><th>Username</th><th>Role</th><th>Dibuat</th><th></th></tr></thead>
                <tbody>
                    <% admins.forEach(a => { %>
                        <tr>
                            <td class="text-zinc-500">#<%= a.id %></td>
                            <td class="font-bold text-white"><%= a.username %> <% if (a.id === admin.id) { %><span class="text-[10px] text-zinc-500">(kamu)</span><% } %></td>
                            <td><span class="px-2 py-0.5 rounded-full text-[10px] font-black <%= a.role === 'owner' ? 'bg-yellow-500/20 text-yellow-300 border border-yellow-500/40' : 'bg-purple-500/20 text-purple-300 border border-purple-500/40' %>"><%= a.role.toUpperCase() %></span></td>
                            <td class="text-zinc-500 text-xs"><%= new Date(a.created_at).toLocaleDateString('id-ID') %></td>
                            <td class="text-right">
                                <% if (a.role !== 'owner' && a.id !== admin.id) { %>
                                    <form method="POST" action="/admin/admins/<%= a.id %>/delete" onsubmit="return confirm('Hapus admin <%= a.username %>?')" class="inline">
                                        <button class="text-red-400 hover:text-red-300 text-xs font-bold">Hapus</button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </section>

        <section class="card rounded-2xl p-5">
            <h2 class="font-bold text-white mb-4">Tambah Admin Baru</h2>
            <form method="POST" action="/admin/admins" class="grid sm:grid-cols-4 gap-3 items-end">
                <div>
                    <label class="lbl">Username</label>
                    <input name="username" class="input" placeholder="3-20 karakter" required>
                </div>
                <div>
                    <label class="lbl">Password (min 8)</label>
                    <input name="password" type="password" class="input" minlength="8" required>
                </div>
                <div>
                    <label class="lbl">Role</label>
                    <select name="role" class="input">
                        <option value="admin">admin — dashboard, user, konten</option>
                        <option value="owner">owner — akses penuh</option>
                    </select>
                </div>
                <button class="btn">Buat Akun</button>
            </form>
            <p class="text-[11px] text-zinc-600 mt-3">Catatan: akun <b>owner</b> tidak bisa dihapus lewat panel. Role <b>admin</b> tidak bisa membuka halaman Rank & Admin.</p>
        </section>
    </main>
</body>
</html>

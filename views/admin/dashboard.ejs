<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('_head', { title: 'Dashboard' }) %>
</head>
<body>
    <%- include('_nav', { admin, section }) %>

    <main class="max-w-6xl mx-auto p-4 md:p-8 space-y-8">
        <h1 class="text-xl md:text-2xl font-black text-white">Dashboard</h1>

        <% if (flash && flash.ok) { %><div class="flash-ok"><%= flash.ok %></div><% } %>

        <section class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
            <div class="card rounded-2xl p-4"><div class="text-2xl font-black text-white"><%= s.totalUsers.toLocaleString('id-ID') %></div><div class="text-[10px] text-zinc-500 font-bold uppercase mt-1">Total User</div></div>
            <div class="card rounded-2xl p-4"><div class="text-2xl font-black text-purple-400"><%= s.totalXp.toLocaleString('id-ID') %></div><div class="text-[10px] text-zinc-500 font-bold uppercase mt-1">Total EXP</div></div>
            <div class="card rounded-2xl p-4"><div class="text-2xl font-black text-indigo-400"><%= s.avgXp.toLocaleString('id-ID') %></div><div class="text-[10px] text-zinc-500 font-bold uppercase mt-1">Rata-rata EXP</div></div>
            <div class="card rounded-2xl p-4"><div class="text-2xl font-black text-green-400"><%= s.activeToday.toLocaleString('id-ID') %></div><div class="text-[10px] text-zinc-500 font-bold uppercase mt-1">Aktif Hari Ini</div></div>
            <div class="card rounded-2xl p-4"><div class="text-2xl font-black text-cyan-400"><%= s.newToday.toLocaleString('id-ID') %></div><div class="text-[10px] text-zinc-500 font-bold uppercase mt-1">Daftar Hari Ini</div></div>
            <div class="card rounded-2xl p-4"><div class="text-2xl font-black text-red-400"><%= s.banned.toLocaleString('id-ID') %></div><div class="text-[10px] text-zinc-500 font-bold uppercase mt-1">Diblokir</div></div>
        </section>

        <section class="grid md:grid-cols-2 gap-6">
            <div class="card rounded-2xl p-5">
                <h2 class="font-bold text-white mb-4">Distribusi Rank User</h2>
                <div class="space-y-2.5">
                    <% dist.forEach(r => { const pct = s.totalUsers ? Math.round(r.count / s.totalUsers * 100) : 0 %>
                        <div class="flex items-center gap-3">
                            <div class="w-24 text-xs text-zinc-400 truncate"><%= r.icon %> <%= r.name %></div>
                            <div class="flex-1 h-5 bg-zinc-800/70 rounded-md overflow-hidden">
                                <div class="h-full rounded-md" style="width: <%= Math.max(pct, r.count ? 2 : 0) %>%; background: <%= r.color %>"></div>
                            </div>
                            <div class="w-20 text-right text-xs text-zinc-400"><%= r.count %> <span class="text-zinc-600">(<%= pct %>%)</span></div>
                        </div>
                    <% }) %>
                </div>
            </div>

            <div class="card rounded-2xl p-5">
                <h2 class="font-bold text-white mb-4">User Terbaru</h2>
                <% if (newest.length) { %>
                    <div class="divide-y divide-white/5">
                        <% newest.forEach(u => { %>
                            <a href="/admin/users/<%= u.id %>" class="flex justify-between items-center py-2.5 hover:bg-white/5 -mx-2 px-2 rounded-lg transition">
                                <span class="text-sm text-white font-medium"><%= u.username %></span>
                                <span class="text-xs text-purple-400 font-bold"><%= u.xp.toLocaleString('id-ID') %> EXP</span>
                            </a>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="text-sm text-zinc-500">Belum ada user terdaftar.</p>
                <% } %>
                <a href="/admin/users" class="text-xs text-purple-400 hover:text-purple-300 font-bold mt-4 inline-block">Kelola semua user →</a>
            </div>
        </section>
    </main>
</body>
</html>

PORT=3000

# PostgreSQL (Neon, Supabase, atau hosting lain).
# Kosongkan = situs berjalan "mode tanpa DB" (akun/EXP/admin panel nonaktif).
DATABASE_URL=postgres://user:password@host:5432/wibukon

# Set 'false' jika Postgres kamu tidak pakai SSL (mis. self-hosted lokal)
# PGSSL=false

# Bootstrap OWNER: user yang login/register dengan username ATAU email ini
# otomatis jadi OWNER — hanya jika situs belum punya owner sama sekali.
# (Owner berikutnya/admin diangkat lewat Panel Admin -> User -> ubah role)
OWNER_USERNAME=owner
# OWNER_EMAIL=emailkamu@gmail.com

# Login Google (OAuth 2.0) — kosongkan untuk menyembunyikan tombol Google.
# Buat di https://console.cloud.google.com/apis/credentials (OAuth client ID, Web).
# Authorized redirect URI: https://domainmu.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
